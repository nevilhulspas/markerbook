  "list_health_tests": {
    "description": "List the user's DEXA scans, microbiome tests, DUTCH tests or RMR tests (id + date + key fields), newest first, one page at a time. \`total\` is the full count; while \`truncated\` is true, call again with \`offset: next_offset\` until it is false. Freely callable — get ids here before get/update/delete.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
