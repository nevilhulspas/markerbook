// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`health-record tool contract > keeps every description and input schema byte-identical 1`] = `
"{
  "list_blood_tests": {
    "description": "List the user's logged blood tests (id, name, date, sample type, marker count), newest first. Freely callable — call this FIRST to get test ids before reading, editing or deleting, and to check whether a test already exists on a date before creating a new one.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  "get_blood_test": {
    "description": "Read one blood test with ALL its marker results (catalog marker name, value, unit). Freely callable. Use the exact returned marker names when correcting or removing results.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "testId": {
          "type": "string"
        }
      },
      "required": [
        "testId"
      ],
      "additionalProperties": false
    }
  },
  "create_blood_test": {
    "description": "Create a NEW blood test with marker results (markers passed by name; matching is automatic — markers are matched to your catalog, resolved to a standard code, or, if neither works, added as a CUSTOM marker, so nothing is dropped). Use ONLY when no test exists for that date — if one does, prefer add_blood_results on it. If a same-date test exists this tool refuses unless \`allowDuplicateDate\` is true (set it only after the user explicitly chose a separate test). Names in \`custom\` were added as new custom markers — mention them to the user as \\"added as a custom marker\\" (never say \\"LOINC\\"). Only genuine failures (empty name / DB error) come back in \`unmatched\`.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "test_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))$",
          "description": "YYYY-MM-DD"
        },
        "name": {
          "description": "Defaults to \\"Blood test <date>\\".",
          "type": "string",
          "maxLength": 200
        },
        "sample_type": {
          "type": "string",
          "enum": [
            "serum",
            "plasma",
            "unknown"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "markers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Biomarker name (catalog name, short name or common alias — e.g. \\"Ferritin\\", \\"HbA1c\\", \\"Vitamin D\\")."
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "description": "Unit as reported. Omit to use the catalog default unit.",
                "type": "string"
              },
              "loinc_code": {
                "description": "LOINC code for this marker when you are confident of it (e.g. \\"2692-2\\" = Serum Osmolality, \\"1649-3\\" = Calcitriol/active vitamin D, \\"2629-4\\" = Methylmalonate, \\"27200-5\\" = ANA). Strongly recommended for specialty markers that aren't common catalog entries — it lets them auto-resolve and add instead of being dropped. The code is validated against the LOINC database, so a wrong guess is safely ignored (falls back to name matching); omit it when unsure.",
                "type": "string",
                "pattern": "^\\\\d{1,7}-\\\\d$"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "allowDuplicateDate": {
          "type": "boolean"
        }
      },
      "required": [
        "test_date",
        "markers"
      ],
      "additionalProperties": false
    }
  },
  "add_blood_results": {
    "description": "Add marker results to an EXISTING blood test (get the id from list_blood_tests). Markers already on the test get their value REPLACED (use this to correct wrong values or complete a partial test — e.g. \\"the remaining results from June 1st\\"); new markers are added. Matching is automatic: catalog match, standard-code resolve, or, failing both, added as a CUSTOM marker. Deduplication is automatic. Names in \`custom\` were added as new custom markers — mention them to the user as \\"added as a custom marker\\" (never say \\"LOINC\\"). Only genuine failures come back in \`unmatched\`.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "testId": {
          "type": "string"
        },
        "markers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Biomarker name (catalog name, short name or common alias — e.g. \\"Ferritin\\", \\"HbA1c\\", \\"Vitamin D\\")."
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "description": "Unit as reported. Omit to use the catalog default unit.",
                "type": "string"
              },
              "loinc_code": {
                "description": "LOINC code for this marker when you are confident of it (e.g. \\"2692-2\\" = Serum Osmolality, \\"1649-3\\" = Calcitriol/active vitamin D, \\"2629-4\\" = Methylmalonate, \\"27200-5\\" = ANA). Strongly recommended for specialty markers that aren't common catalog entries — it lets them auto-resolve and add instead of being dropped. The code is validated against the LOINC database, so a wrong guess is safely ignored (falls back to name matching); omit it when unsure.",
                "type": "string",
                "pattern": "^\\\\d{1,7}-\\\\d$"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "testId",
        "markers"
      ],
      "additionalProperties": false
    }
  },
  "remove_blood_results": {
    "description": "Remove specific marker results from a blood test by marker name (e.g. a marker logged by mistake). The test itself stays. Use only on explicit user request.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
