# Copy to .env.local (development) or pass to the container (production).
# Variables starting with NEXT_PUBLIC_ are built into the browser bundle.

# --- Required -----------------------------------------------------------------

# Supabase project (Settings -> API). The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public URL of this installation, e.g. https://health.example.com
# Used for sign-in redirects and to identify the app to third-party APIs.
NEXT_PUBLIC_SITE_URL=

# Anthropic API key for every AI feature (import, interpretation, chat).
ANTHROPIC_API_KEY=

# Your e-mail address. After you sign up, `npm run make-admin` makes this account
# admin, and `npm run demo` loads its demo data into it. Signing up alone never
# grants admin.
ADMIN_EMAIL=

# --- Optional -----------------------------------------------------------------

# OpenAI API key, only for voice input in the nutrition log (Whisper).
OPENAI_API_KEY=

# Time zone for "today" on server and browser (IANA name). Default Europe/Amsterdam.
NEXT_PUBLIC_APP_TIME_ZONE=

# AI requests per user per hour / per day. Defaults 60 and 300; 0 = no limit.
AI_REQUESTS_PER_HOUR=
AI_REQUESTS_PER_DAY=

# Contact e-mail sent to Open Food Facts in the User-Agent (they ask for one).
# Defaults to NEXT_PUBLIC_SITE_URL.
CONTACT_EMAIL=
